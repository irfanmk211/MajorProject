rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /crop_predictions/{predictionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'userId', 'input', 'predictions', 'createdAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 500;
        allow delete: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /readings/{readingId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      match /notification_tokens/{tokenId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'token', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 4096;
        allow delete: if isOwner(userId);
      }

      match /farms/{farmId} {
        allow read, create, update, delete: if isOwner(userId);

        match /fields/{fieldId} {
          allow read, create, update, delete: if isOwner(userId);

          match /readings/{readingId} {
            allow read: if isOwner(userId);
            allow create: if isOwner(userId)
              && request.resource.data.keys().hasOnly([
                'temperature', 'humidity', 'soil', 'soil_moisture_percent',
                'ldr', 'irrigation', 'pump_state', 'source', 'recordedAt'
              ])
              && request.resource.data.recordedAt == request.time;
            allow update, delete: if false;
          }
        }
      }
    }
  }
}
