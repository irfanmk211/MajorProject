# Optional fallback for devices without an installed Kannada speech voice.
# Enable Google Cloud Text-to-Speech and set a restricted API key here.
GOOGLE_TTS_API_KEY=

# Add these as Render environment variables; never commit real credentials.
PYTHON_VERSION=3.11.9
CLOUDINARY_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=agrosmart-mp

# Optional: enable the AI chat endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
